# Copy to .env and fill in. Never commit .env to GitHub.
TELEGRAM_BOT_TOKEN=put_new_token_from_botfather
API_KEY=put_new_api_key
API_BASE=https://openmarketplace.in/public/index.php/api/pocket-fm-api
# Your numeric Telegram ID (get it from @userinfobot). Comma-separate multiple admins.
ADMIN_IDS=123456789
# If your working curl uses a different search path/param, change these:
SEARCH_PATH=/universal-search
SEARCH_PARAM=query
# 1 = force IPv4 (recommended on VPS)
FORCE_IPV4=1
# Max episodes per request when user types a range
MAX_BATCH=20

# --- Episode list pagination (API returns ~8 episodes per page; the bot auto-detects the page parameter) ---
# If auto-detect fails, run /debugshow <id> <param> 2 as admin and pin the working one here:
# EPISODE_PAGE_PARAM=page
# EPISODE_PAGE_MODE=page        # "page" = 1,2,3...   "offset" = 0,8,16...
# Optional: ask for bigger pages if the API supports it (fewer calls)
# EPISODE_LIMIT_PARAM=limit
# EPISODE_LIMIT=100
